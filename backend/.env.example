# ============================================================
# SaaS de Captura de Leads — variáveis de ambiente do backend
# Copie para .env e preencha. NUNCA commitar o .env.
# ============================================================

# Servidor
PORT=3000
# Origin do painel (frontend no Vercel) — liberado no CORS das rotas autenticadas
PAINEL_ORIGIN=http://localhost:5173

# MySQL (Railway: use as variáveis do serviço MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saas_leads

# Autenticação (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Validade dos tokens de sessão
JWT_EXPIRACAO=8h

# Criptografia AES-256-GCM das credenciais de CRM e tokens de instância.
# EXATAMENTE 64 caracteres hex (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Trocar esta chave invalida TODAS as credenciais já salvas no banco.
CRYPTO_KEY=

# Evolution API (chave GLOBAL — só vive no backend; tenants recebem token próprio por instância)
EVOLUTION_BASE_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=

# Worker da fila
WORKER_ATIVO=true
WORKER_INTERVALO_MS=3000
WORKER_LOTE=5

# Rate limit do endpoint público de captura (por IP)
CAPTURA_RATE_LIMIT_JANELA_MS=60000
CAPTURA_RATE_LIMIT_MAX=30
